# ---------------------------------------------------------------------
# Modèle de configuration. À copier en `.env` puis à adapter :
#
#     cp .env.example .env
#
# `.env` est ignoré par git (voir .gitignore). Ce fichier-ci est versionné
# et ne doit JAMAIS contenir de vrai mot de passe.
#
# POURQUOI CES NOMS DE VARIABLES EXACTEMENT ?
# Ce ne sont pas des noms inventés : PGHOST, PGPORT, PGDATABASE, PGUSER et
# PGPASSWORD sont les variables d'environnement standard de libpq, la
# bibliothèque cliente de PostgreSQL. `psql`, `pg_dump`, `psycopg2` et la
# plupart des clients les lisent automatiquement.
#
# Conséquence concrète : une fois ce fichier chargé dans le shell, la
# commande
#     psql -f sql/04_exploration.sql
# fonctionne SANS aucun argument -h / -p / -U / -d. C'est le script
# scripts/run_sql.sh qui fait ce chargement.
# ---------------------------------------------------------------------

# Serveur PostgreSQL
PGHOST=localhost
PGPORT=5432

# Base de données cible (à créer une fois : createdb movie_analysis)
PGDATABASE=movie_analysis

# Identifiants
PGUSER=movie_user
PGPASSWORD=remplacez_moi

# ---------------------------------------------------------------------
# Et le chemin du CSV ?
#
# Il n'est volontairement PAS une variable d'environnement. Le fichier
# sql/02_import_data.sql référence 'data/raw/movieData.csv' en chemin
# relatif, et run_sql.sh se place à la racine du dépôt avant d'appeler
# psql : le chemin est donc déjà portable d'une machine à l'autre.
#
# Une variable serait de toute façon inopérante ici : la méta-commande
# \copy de psql n'interpole pas les variables psql. Les détails sont
# documentés en tête de sql/02_import_data.sql.
# ---------------------------------------------------------------------
